# Free LLM APIs (from https://github.com/mnfst/awesome-free-llm-apis)
# Optional: Set any of these keys to use free inference tiers directly in Adumate failover rotation.
# If none are set, the platform uses intelligent local deterministic knowledge fallback.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""
NVIDIA_API_KEY=""
TOGETHER_API_KEY=""
CEREBRAS_API_KEY=""
SAMBANOVA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://adumate.in"

# PORT: Local development server port
PORT="3000"

# CONTACT_RECEIVER_EMAIL: Contact form recipient (defaults to ayushkaushik1441@gmail.com)
CONTACT_RECEIVER_EMAIL="ayushkaushik1441@gmail.com"
